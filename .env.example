APP_NAME=NeuroSQL
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=neurosql-dev-secret-key-for-local-development-only-not-production
API_V1_PREFIX=/api/v1

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://neurosql:neurosql_dev_password@postgres:5432/neurosql_db
POSTGRES_DB=neurosql_db
POSTGRES_USER=neurosql
POSTGRES_PASSWORD=neurosql_dev_password

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

OPENAI_API_KEY=sk-your-real-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PINECONE_API_KEY=your-real-pinecone-key-here
PINECONE_INDEX_NAME=neurosql-schema
PINECONE_ENVIRONMENT=us-east-1

CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

DEFAULT_ORG_NAME=Default Organization
SUPER_ADMIN_EMAIL=admin@neurosql.dev
SUPER_ADMIN_PASSWORD=admin123

CORS_ALLOWED_ORIGINS=http://localhost:5173

CELERY_WORKER_CONCURRENCY=4