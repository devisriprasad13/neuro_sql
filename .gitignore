cat > .gitignore << 'EOF'

# Environment files
.env
**/.env
.env.*
*.env
!.env.example

.env.local
.env.production
.env.staging

# ------------------------------------------------------------------ #
# Python
# ------------------------------------------------------------------ #

# Compiled bytecode — generated automatically, never commit
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Virtual environments — each developer creates their own locally
.venv/
venv/
ENV/
env/

# MyPy type checker cache
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest cache and coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc

# Ruff linter cache
.ruff_cache/

# ------------------------------------------------------------------ #
# Node.js / React Frontend
# ------------------------------------------------------------------ #

# Dependencies — installed via npm install, never committed
node_modules/

# Build output — generated by npm run build
frontend/dist/
frontend/build/

# Vite cache
frontend/.vite/

# NPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------ #
# Docker
# ------------------------------------------------------------------ #
docker-compose.override.yml

# ------------------------------------------------------------------ #
# IDEs and editors
# ------------------------------------------------------------------ #

# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iml
*.iws

# Vim swap files
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------------ #
# Logs
# ------------------------------------------------------------------ #
*.log
logs/
log/

# ------------------------------------------------------------------ #
# Alembic
# ------------------------------------------------------------------ #
alembic/__pycache__/

# ------------------------------------------------------------------ #
# Secrets and certificates
# ------------------------------------------------------------------ #
*.pem
*.key
*.cert
*.crt
secrets/
EOF